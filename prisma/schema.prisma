generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  cooking_time Int          @map("cooking_time")
  serving      Int
  difficulty   String
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  ingredients  Ingredient[]
  photoPath    String?

  @@map("recipes")
}

model Ingredient {
  id        Int      @id @default(autoincrement())
  recipe_id Int
  name      String
  qty       Int
  unit      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  recipe    Recipe   @relation(fields: [recipe_id], references: [id])
  imagePath String?
}
